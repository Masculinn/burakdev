    "gen:xml": "ts-node scripts/generate-xml.ts",
    "convert:webp": "ts-node scripts/convert-to-webp.ts --input ./webp-temp --output ./webp-out",
    "start": "next start",
    "serve": "npx serve@latest ./out",
